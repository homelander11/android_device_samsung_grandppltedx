# Unified diffs contain space-prefixed empty context lines by definition.
*.patch whitespace=-blank-at-eol,-blank-at-eof
# Keep staged charger resources and upstream font licensing byte-exact.
tools/charger/candidate/* -text
tools/charger/candidate/OFL.txt whitespace=-blank-at-eol
tools/charger/candidate/FONT-README whitespace=-blank-at-eof
