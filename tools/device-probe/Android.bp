// Diagnostic only; never installed in the ROM.
cc_binary {
    name: "grandppltedx_hal_link_probe",
    srcs: ["hal_link_probe.c"],
    shared_libs: ["libdl"],
    compile_multilib: "32",
    installable: false,
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_binary {
    name: "grandppltedx_light_probe",
    srcs: ["light_probe.cpp"],
    shared_libs: [
        "android.hardware.light@2.0",
        "libdl",
        "libhidlbase",
        "libutils",
    ],
    compile_multilib: "32",
    installable: false,
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_binary {
    name: "grandppltedx_gralloc_cleanup_probe",
    srcs: ["gralloc_cleanup_probe.c"],
    shared_libs: ["libdl"],
    compile_multilib: "32",
    installable: false,
    ldflags: ["-Wl,--export-dynamic"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
